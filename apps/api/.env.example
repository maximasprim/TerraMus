ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://farm:farm@localhost:5432/farmdb
REDIS_URL=redis://localhost:6379/0

# Rate limiting backend (spec §29). "memory" needs nothing extra and is what
# this build's tests and single-instance docker-compose use. Switch to
# "redis" only once running more than one API replica.
RATE_LIMIT_BACKEND=memory

JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi

CORS_ORIGINS=["http://localhost:3000"]

# Spec §38 QR codes: base URL a scanned QR resolves to (the public storefront).
# A real deployment MUST override this - QR codes generated before that
# change point at the wrong place.
PUBLIC_SITE_BASE_URL=http://localhost:3000

# Spec §47 - leave empty to disable OpenTelemetry tracing entirely (default).
# Set to a collector's OTLP HTTP endpoint to enable it, e.g.:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# Email (spec §13/§55). "mock" needs nothing extra and is what tests use -
# it always succeeds without a network call. Switch to "smtp" and fill in
# the fields below to send real email.
EMAIL_PROVIDER_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example-farm.co.ke
SMTP_USE_TLS=true

# Payments (spec §21-22, §49) - never commit real values.
# PAYMENT_PROVIDER_MODE defaults to "mock" so dev/test never needs real credentials.
PAYMENT_PROVIDER_MODE=mock
MOCK_PAYMENT_SECRET=replace-with-a-long-random-value

# M-Pesa Daraja - required only if actually calling the mpesa provider.
# NOTE: not live-tested in this build (see docs/architecture.md Phase 5 note).
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_CALLBACK_SHARED_SECRET=

# Stripe - required only if actually calling the stripe provider.
# NOTE: not live-tested in this build (see docs/architecture.md Phase 5 note).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
