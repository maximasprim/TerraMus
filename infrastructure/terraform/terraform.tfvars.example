#   STORAGE_BACKEND         = "supabase"
#   SUPABASE_URL            = "https://<project-ref>.supabase.co"
#   SUPABASE_STORAGE_BUCKET = "listing-images"
# }
# extra_secrets = {                       # stored in AWS Secrets Manager, not in the task definition
#   SUPABASE_SECRET_KEY = "sb_secret_CHANGEME"
# }
